{
  "name": "tracker-mcp",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Local 11-tool MCP server for Tracker video analysis, with a separate GPL-3 Java service.",
  "license": "GPL-3.0-only",
  "repository": {"type":"git","url":"git+https://github.com/YtKhurana/tracker-mcp.git"},
  "files": ["dist", "src", "tsconfig.json", "README.md", "CHANGELOG.md", "docs", "service/src", "service/test", "service/build.sh", "service/LICENSE", "service/README.md", "service/PROTOCOL.md", "scripts/run-job-c.mjs", "scripts/run-job-d.mjs", "scripts/run-job-e.mjs", "scripts/run-job-f.mjs", "scripts/run-job-g.mjs", "scripts/verify-official.mjs", "scripts/test-service-unit.mjs", "fixtures/golden", "fixtures/official"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tracker-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:service": "zsh service/build.sh",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:service-unit": "node scripts/test-service-unit.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "prepack": "npm run build",
    "checkpoint": "node scripts/prepare-checkpoint.mjs",
    "job:c": "node scripts/run-job-c.mjs",
    "job:d": "node scripts/run-job-d.mjs",
    "job:e": "node scripts/run-job-e.mjs",
    "job:f": "node scripts/run-job-f.mjs",
    "job:g": "node scripts/run-job-g.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pngjs": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2"
  }
}

{
  "name": "tracker-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP sidecar for Tracker projects. JSON/file only — does not link tracker.jar.",
  "files": ["dist", "src", "README.md", "service/LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tracker-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:service-unit": "node scripts/test-service-unit.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "prepack": "npm run build",
    "checkpoint": "node scripts/prepare-checkpoint.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2"
  }
}
